#!/bin/bash
# Update everything this repo manages: brew, node, npm globals, editor plugins.
# Idempotent and safe to re-run.

set -uo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$DOTFILES_DIR/bin/lib.sh"

brewfile="$DOTFILES_DIR/system/brew/Brewfile"
brew update
brew bundle --file "$brewfile"                                 # install anything missing
brew upgrade $(brew bundle list --file "$brewfile" --formula)  # only declared formulae; casks self-update

if [ -s ~/.nvm/nvm.sh ]; then
  info "Updating node LTS..."
  source ~/.nvm/nvm.sh
  nvm install --lts   # any new LTS auto-gets ~/.nvm/default-packages
fi

# Refresh the default (nvm) packages, but only in the node versions we use day to
# day (default + current). New versions get them automatically via
# ~/.nvm/default-packages, so there's no need to loop all installed versions.
if [ -s ~/.nvm/nvm.sh ] && command -v npm &>/dev/null; then
  info "Updating default npm packages..."
  pkgs=$(grep -vE '^[[:space:]]*(#|$)' "$DOTFILES_DIR/system/npm/global-packages" | tr '\n' ' ')
  for v in $(printf '%s\n' "$(nvm version default)" "$(nvm current)" | sort -u); do
    [[ "$v" == none || "$v" == N/A || -z "$v" ]] && continue
    info "  $v"
    nvm exec "$v" npm install -g $pkgs
  done
fi

if command -v codex &>/dev/null; then
  info "Updating codex..."
  curl -fsSL https://chatgpt.com/codex/install.sh | sh
fi

info "Updating tmux plugin manager..."
[[ -d ~/.tmux/plugins/tpm ]] && git -C ~/.tmux/plugins/tpm pull --ff-only

info "Updating vim-sensible..."
[[ -d ~/.vim/pack/tpope/start/sensible ]] && git -C ~/.vim/pack/tpope/start/sensible pull --ff-only

success "Done!"
