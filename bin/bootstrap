#!/bin/bash
# Fresh-machine entrypoint. From a clean macOS to a configured machine:
# installs Xcode Command Line Tools, Homebrew, and git, clones this repo, then
# hands off to bin/setup. Idempotent, safe to re-run.
#
# Runs under /bin/bash (always present) since brew's zsh doesn't exist yet on a
# fresh machine. Can be curl'd standalone or run from a clone.

set -uo pipefail

REPO_URL="https://github.com/bradleyoesch/dotfiles.git"
DOTFILES_DIR="$HOME/bradleyoesch/dotfiles"

echo "==> Xcode Command Line Tools..."
if xcode-select -p &>/dev/null; then
  echo "    already installed"
else
  echo "    installing (accept the GUI dialog that appears)..."
  xcode-select --install
  until xcode-select -p &>/dev/null; do sleep 5; done
fi

echo "==> Homebrew..."
if command -v brew &>/dev/null; then
  echo "    already installed"
else
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

echo "==> Cloning dotfiles..."
if [ -d "$DOTFILES_DIR/.git" ]; then
  echo "    already cloned at $DOTFILES_DIR"
else
  mkdir -p "$(dirname "$DOTFILES_DIR")"
  git clone "$REPO_URL" "$DOTFILES_DIR"
fi

echo "==> Running setup..."
# setup's `#!/usr/bin/env zsh` resolves to system zsh here, brew's zsh later.
exec "$DOTFILES_DIR/bin/setup"
