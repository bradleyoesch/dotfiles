# create a new directory and enter it
mk() {
  mkdir -p "$@" && cd "$@"
}

# copy with ".bak" extension
# -cp to copy (default)
# -mv to rename
bak() {
  if [ "$1" = "-cp" ]; then
    cp $2 $2.bak
    echo "Copied to $2.bak"
  elif [ "$1" = "-mv" ]; then
    mv $2 $2.bak
    echo "Renamed to $2.bak"
  else
    cp $1 $1.bak
    echo "Copied to $1.bak"
  fi
}

# copy with ".bak" extension
# -cp to copy (default)
# -mv to rename
rebak() {
  if [ "$1" = "-cp" ]; then
    cp $2 "${2//.bak}"
    echo "Copied to ${2//.bak}"
  elif [ "$1" = "-mv" ]; then
    mv $2 "${2//.bak}"
    echo "Renamed to ${2//.bak}"
  else
    cp $1 "${1//.bak}"
    echo "Copied to ${1//.bak}"
  fi
}

# copy file contents to clipboard
cpp() { pbcopy < "$1" }

# paste clipboard contents to file (replaces file)
pst() { pbpaste > "$1" }

# glow: apply the monokai theme. glow.yml can't expand $HOME in its `style`
# path, so pass an absolute path here where the shell expands it.
glow() { command glow --style "$HOME/Library/Preferences/glow/monokai.json" "$@" }

function git_main_branch() {
  command git rev-parse --git-dir &>/dev/null || return
  local ref
  for ref in refs/{heads,remotes/{origin,upstream}}/{main,primary,trunk,mainline,default,stable,master}; do
    if command git show-ref -q --verify $ref; then
      echo ${ref:t}
      return 0
    fi
  done

  # If no main branch was found, fall back to master but return error
  echo master
  return 1
}

# keep the mac awake: coffee 30m | coffee 1h | coffee 90 (bare = minutes)
# anything not starting with a digit is passed straight through to caffeinate
coffee() {
  integer s   # truncates 1.5h
  case $1 in
    [0-9]*h) s=$(( ${1%h} * 3600 ));;
    [0-9]*)  s=$(( ${1%m} * 60 ));;
    *) caffeinate "$@"; return;;
  esac
  print "☕️ until $(date -v+${s}S '+%-l:%M%p' | tr 'APM' 'apm')"
  caffeinate -d -u -t $s "${@:2}"
}
